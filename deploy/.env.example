# EC2의 deploy/.env로 복사해 값을 채운다 (.env는 커밋하지 않음)

# 접속 주소 (EIP, 끝에 / 없이)
SITE_URL=http://<EIP>

# 구글 로그인 (앱 빌드 시 번들에 들어감)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# DB
POSTGRES_DB=stockdemy
POSTGRES_USER=stockdemy
POSTGRES_PASSWORD=

# 인증 (32바이트 이상, 예: openssl rand -base64 48)
JWT_SECRET=

# 외부 API
DART_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
