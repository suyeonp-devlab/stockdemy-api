spring:
  datasource:
    url: your-postgres-db-url
    username: your-db-username
    password: your-db-password
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
  flyway:
    enabled: true
    locations: classpath:db/migration
  data:
    redis:
      host: localhost
      port: 6379

logging:
  level:
    org.hibernate.SQL: debug

jwt:
  secret: change-this-to-any-random-string-at-least-32-bytes-long